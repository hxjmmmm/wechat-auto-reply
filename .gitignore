data/
*.log
*.log.*
_ocr_out.txt
# 打包产物（exe 里可能带本机信息，且体积几十 MB）
dist/
分享包/
.build/
*.exe
*.zip
# 工作区记忆（含真实昵称、wxid 等）
.workbuddy/
__pycache__/
*.pyc
*.pyo
.idea/
.vscode/
.DS_Store
